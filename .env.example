# Copy to .env and fill in. .env is gitignored and must stay mode 600. Never commit real values.

# Alchemy, with Robinhood Chain Mainnet enabled for the app. A full archive node on chain 4663.
ALCHEMY_KEY=
# News and earnings calendar. Free plan.
FINNHUB_API_KEY=
# SERV Reasoning inference key, from console.openserv.ai. Data collection must be enabled on the org.
SERV_API_KEY=
# Registers the agent under YOUR OpenServ account, from platform.openserv.ai. Without it, provisioning stops.
OPENSERV_USER_API_KEY=

# Local Postgres. We are local-first. Create with: createdb desk_dev && createdb desk_test
# desk_rehearsal is throwaway and is created for you by: pnpm rehearsal:reset
DATABASE_URL=postgresql://<you>@localhost:5432/desk_dev
TEST_DATABASE_URL=postgresql://<you>@localhost:5432/desk_test
REHEARSAL_DATABASE_URL=postgresql://localhost:5432/desk_rehearsal

# Dev wallets. Generate with `cast wallet new`. Small amounts only. Never reuse for production.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
