# The web app reads. It never signs, never sends a transaction and never calls a provider.
# So it gets ONE value and no keys: without a signing key it cannot move money even if it is compromised.
# Next.js only reads env files from this directory, not from the repo root.
DATABASE_URL=postgresql://localhost:5432/desk_dev

# Signs the session cookie. Any 32+ character secret. Generate with: openssl rand -base64 48
SESSION_SECRET=

# The assistant's public address, so the site can tell one of our desks from an impostor. Not a secret.
OPERATOR_ADDRESS=0x...

# Encrypts the OpenServ webhook URLs owners save under Connections (AES-256-GCM). The worker needs the SAME value
# to send decisions there. Separate from SESSION_SECRET on purpose. Generate with: openssl rand -base64 32
OPENSERV_WEBHOOK_KEY=

# Where Shijima's 20% share of each copy fee is paid (a public address, not a key).
TREASURY_ADDRESS=
# The docs site's https address (docs-site/, its own Coolify app). Build time. Leave empty until it is deployed:
# the footer and /docs then show no link to it.
NEXT_PUBLIC_DOCS_URL=
