{
  "name": "desk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "tokens:build": "tsx --env-file-if-exists=.env scripts/build-tokens.ts",
    "worker:dev": "pnpm --filter @desk/worker dev",
    "worker:start": "pnpm --filter @desk/worker start",
    "dev:funds": "tsx --env-file-if-exists=.env scripts/dev-funds.ts",
    "abis:build": "tsx scripts/build-abis.ts",
    "dev:desk": "tsx --env-file-if-exists=.env scripts/dev-desk.ts",
    "desk:skeleton": "pnpm --filter @desk/worker skeleton",
    "db:generate": "pnpm --filter @desk/db generate",
    "db:migrate": "pnpm --filter @desk/db migrate",
    "records:import": "tsx --env-file-if-exists=.env scripts/import-file-records.ts",
    "rehearsal:reset": "tsx --env-file-if-exists=.env scripts/rehearsal-db.ts",
    "rehearse:copy": "tsx --env-file-if-exists=.env scripts/rehearse-copy.ts",
    "desk:resolve": "pnpm --filter @desk/worker resolve",
    "dev:prove-limits": "tsx --env-file-if-exists=.env scripts/prove-limits.ts",
    "dev:prove-alerts": "tsx --env-file-if-exists=.env scripts/prove-alerts.ts",
    "desk:mandate": "pnpm --filter @desk/worker mandate",
    "desk:wake": "pnpm --filter @desk/worker wake",
    "desk:review": "pnpm --filter @desk/worker review",
    "desk:ask": "pnpm --filter @desk/worker ask",
    "prices:log": "tsx --env-file-if-exists=.env scripts/prices.ts",
    "prices:backfill": "tsx --env-file-if-exists=.env scripts/prices.ts backfill",
    "prices:facts": "tsx --env-file-if-exists=.env scripts/prices.ts facts",
    "desk:mode": "pnpm --filter @desk/worker wake --set-mode",
    "desk:pause": "pnpm --filter @desk/worker wake --pause",
    "desk:resume": "pnpm --filter @desk/worker wake --resume",
    "desk:approvals": "pnpm --filter @desk/worker approve --list",
    "desk:approve": "pnpm --filter @desk/worker approve",
    "desk:reject": "pnpm --filter @desk/worker approve --reject",
    "desk:share": "pnpm --filter @desk/worker wake --share",
    "web:dev": "pnpm --filter @desk/web dev",
    "web:build": "pnpm --filter @desk/web build",
    "desk:grade": "pnpm --filter @desk/worker grade",
    "openserv:provision": "pnpm --filter @desk/worker openserv:provision",
    "openserv:fire": "pnpm --filter @desk/worker openserv:fire",
    "desk:link": "pnpm --filter @desk/worker telegram-link",
    "compare:run": "tsx --env-file-if-exists=.env scripts/compare.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@desk/chain": "workspace:*",
    "@desk/core": "workspace:*",
    "@desk/db": "workspace:*",
    "@desk/shared": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  }
}
